# AI Text Processor - Local Development Run Script (Template)
# Copy this file to run.ps1 and fill in your credentials

# Set environment variables
$env:DB_PASSWORD="your_database_password_here"
$env:DB_USERNAME="root"
$env:DB_URL="jdbc:mysql://localhost:3306/text_summarizer_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true"
$env:GEMINI_API_KEY="your_gemini_api_key_here"

# Display the configuration
Write-Host "`n========================================" -ForegroundColor Green
Write-Host "AI Text Processor - Starting Application" -ForegroundColor Green
Write-Host "========================================" -ForegroundColor Green
Write-Host "`nConfiguration:"
Write-Host "- Database URL: $($env:DB_URL)" -ForegroundColor Cyan
Write-Host "- Database User: $($env:DB_USERNAME)" -ForegroundColor Cyan
Write-Host "- Gemini API Key: $($env:GEMINI_API_KEY.Substring(0, 10))..." -ForegroundColor Cyan
Write-Host "`n========================================`n" -ForegroundColor Green

# Build and run the application
Write-Host "Building and starting the application..." -ForegroundColor Yellow
mvn clean install
mvn spring-boot:run

# If there's an error, pause so user can see it
if ($LASTEXITCODE -ne 0) {
    Write-Host "`nApplication failed to start. Press any key to exit..." -ForegroundColor Red
    $null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
}
